# Fine-grained Hugging Face token with "Make calls to Inference Providers" permission.
# Keep this value on the server; never expose it in frontend code.
HF_TOKEN=

# Comma-separated exact model IDs that appear in the configured provider's /v1/models catalog.
HERETIC_MODEL_IDS=

# Optional OpenAI-compatible inference base URL. Defaults to Hugging Face Inference Providers.
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
