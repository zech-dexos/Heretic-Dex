# API key for the OpenAI-compatible hosted inference provider.
# Keep this value on the server; never expose it in frontend code.
INFERENCE_API_KEY=

# Featherless is the first planned provider. It exposes /v1/models and
# /v1/chat/completions using an OpenAI-compatible API.
INFERENCE_BASE_URL=https://api.featherless.ai/v1

# Start with one known Heretic model. Add other exact model IDs only after
# confirming they are available on the provider account/plan.
HERETIC_MODEL_IDS=experimentalmachines/LFM2.5-1.2B-Instruct-heretic

# Optional public app attribution headers sent to the inference provider.
INFERENCE_REFERER=https://heretic-dex.onrender.com/
INFERENCE_APP_NAME=Heretic Test-Drive

# Cost/abuse guardrails: 10 requests per IP per 10 minutes; max 500 output tokens.
MAX_REQUESTS_PER_WINDOW=10
MAX_OUTPUT_TOKENS=500

# Legacy Hugging Face variable names remain supported by server.js.
# HF_TOKEN=
# HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
